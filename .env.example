# 复制为 .env 后填写；.env 已在 .gitignore 中，不会被提交。
# 离线运行（--provider mock）无需任何配置。

# OpenAI 兼容接口（DeepSeek / Qwen-DashScope / Kimi / OpenAI / vLLM 等均可）
# --provider deepseek 时，未填写的 BASE_URL / MODEL 使用下列 DeepSeek 默认值
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_MODEL=deepseek-flash

# 可选
LLM_TEMPERATURE=0
LLM_TIMEOUT_SEC=90
